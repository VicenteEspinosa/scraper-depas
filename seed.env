# The starting set. A database with no `preferences` table yet is seeded from this
# file, so a fresh clone already scrapes something sensible instead of refusing to
# run. Anything exported, or set in .env, overrides a line here.
#
# After that first seed neither file is read again: the table is the configuration.
# Edit it with `depas config set NAME valor`, and `depas config` lists everything
# with what it means. `depas config import-env --force` pulls the files back in.
#
# Credentials are not settings and never live here -- see .env.example.

# -- what is even looked at ------------------------------------------------------
# Commune slugs the hourly pass scrapes, and the coarse portal-side filters.
DEPAS_COMMUNES=providencia,las-condes
DEPAS_BEDROOMS_MIN=2
# Latest move-in date you would accept. An aviso that states no date still alerts.
DEPAS_AVAILABLE_BY=2026-11-01
# Nota a card has to reach to be published. Anything under it is marked all the same,
# so it does not come back when the pool moves.
DEPAS_GRADE_MIN=40

# -- cost, always net: arriendo + gastos comunes - sublet income -----------------
# The target scores 80 and beating it earns the rest; from there it falls away to 40 at
# the maximum, which is a hard ceiling -- over it there is no alert.
DEPAS_COST_TARGET=800000
DEPAS_COST_MAX=950000
DEPAS_COST_WEIGHT=1

# -- walk to the Metro, in minutes ------------------------------------------------
DEPAS_WALK_TARGET=10
DEPAS_WALK_MAX=15
DEPAS_WALK_WEIGHT=1

# -- area in m2. The minimum is a floor, but an aviso that publishes no surface still
# -- alerts: it only scores at the bottom of the component.
DEPAS_AREA_MIN=42
DEPAS_AREA_TARGET=50
DEPAS_AREA_WEIGHT=1

# -- commute, in minutes to the location a listing reaches worst ------------------
DEPAS_COMMUTE_TARGET=25
DEPAS_COMMUTE_MAX=60
DEPAS_COMMUTE_WEIGHT=1
# Every place you have to be able to reach, as `nombre,lat,lon` separated by `;`. The
# name is only a label, and it is what the alert cards and the tables print.
#
# These two are placeholders -- Costanera Center and Parque Bustamante -- so a fresh
# clone routes something real and you can see the commute column working. Replace them
# with your own, which you can do in words instead of coordinates:
#
#   depas config set DEPAS_LOCATIONS "pega,Avenida Providencia 1234; gimnasio,Los Leones 500"
#
# The addresses are geocoded once, on the way in, and the match is printed back.
DEPAS_LOCATIONS=pega,-33.41725,-70.60759; gimnasio,-33.44353,-70.63137

# -- the rest of the graded parameters --------------------------------------------
# Ideal floor. Lower scores worse without being excluded; never a cutoff.
DEPAS_FLOOR_TARGET=5
DEPAS_FLOOR_WEIGHT=1
# Ideal antigüedad in years. The one target that applies even unset -- clearing it
# falls back to 25 rather than switching the component off.
DEPAS_AGE_TARGET=20
DEPAS_AGE_WEIGHT=1
# Conserjería you want. Not a cutoff: an aviso without it just scores lower.
DEPAS_SECURITY_WANTED=24 horas
DEPAS_SECURITY_WEIGHT=1
# Metro lines in tiers, best first: `>` separates tiers, `,` lists lines worth the same.
DEPAS_METRO_TIERS=1 > 3,6 > 2,4,4A,5
DEPAS_METRO_WEIGHT=1
# Scored off the listing alone, so they weigh something without configuring anything.
DEPAS_VALUE_WEIGHT=1
DEPAS_AMENITIES_TARGET=4
DEPAS_AMENITIES_WEIGHT=1

# -- yes/no properties: exclude drops the listing, penalise only costs it score ----
DEPAS_FURNISHED=exclude
DEPAS_TOP_FLOOR=penalise
DEPAS_TRAITS_WEIGHT=1

# -- what a listing is priced and compared against ---------------------------------
# CLP a month you would collect subletting the parking space and the storage unit.
DEPAS_PARKING_INCOME=60000
DEPAS_STORAGE_INCOME=30000
# What you pay today, net. Leave it out if you set DEPAS_CURRENT_HOME -- it is derived.
DEPAS_CURRENT_COST=710000
# Your own flat as one JSON object, so /compare can measure any aviso against it.
# Unset here for the same reason as DEPAS_LOCATIONS: it says where you live.
# DEPAS_CURRENT_HOME={"commune":"nunoa","price_clp":800000,"common_expenses":130000,"area_m2":62,"lat":-33.45590,"lon":-70.59780}

# Where the alerts are posted. `depas chats` lists what the bot can see.
# TELEGRAM_CHAT_ID=-1001234567890
