# Monthly CLP you expect to collect by leasing out the unit's parking and storage.
# Both default to 0, which makes net cost equal total cost.
DEPAS_PARKING_INCOME=0
DEPAS_STORAGE_INCOME=0

# Relative weight of each grading component (even split by default).
# A grade is a percentile against everything currently scraped: 80 beats 80% of listings.
DEPAS_WEIGHT_VALUE=1
DEPAS_WEIGHT_COST=1
DEPAS_WEIGHT_LOCATION=1
DEPAS_WEIGHT_SIZE=1
DEPAS_WEIGHT_AMENITIES=1
DEPAS_WEIGHT_SECURITY=1
DEPAS_WEIGHT_FLOOR=1
DEPAS_WEIGHT_METRO=1

# Where the SQLite file lives. Pinned to /data/depas.db in docker-compose.yml.
# DEPAS_DB_PATH=depas.db

# Hourly watch: which communes to scrape, plus the coarse portal-side filters.
# Sample values only -- put your real search in .env, which is gitignored.
DEPAS_ALERT_COMMUNES=nunoa,santiago
DEPAS_ALERT_MIN_BEDROOMS=2

# Requirements applied to alerts after enrichment. Every figure here is the net
# monthly cost -- rent + gastos comunes - sublet income -- never the asking rent,
# which is not a number worth setting. Leave any blank to not filter on it.
# What we aim to spend. At or under this a listing gets full marks on cost, then
# the score degrades to zero at MAX_COST. Nothing is excluded for being over target.
DEPAS_TARGET_COST=850000
# Hard ceiling: over this, no alert. The rent ceiling used while crawling is derived
# from these figures, so there is no separate asking-rent setting.
DEPAS_ALERT_MAX_COST=950000
# Ideal walk to the Metro. At or under it a listing gets full marks on location,
# then the score degrades to zero at MAX_WALK. Nothing is excluded for being over.
DEPAS_TARGET_WALK=10
DEPAS_ALERT_MAX_WALK=15
# Metro lines in tiers, best first: ">" separates tiers, "," lists lines worth the same.
# A station is scored by the best line calling at it, so an interchange takes its better
# one. A line left off ranks below every tier. Leave blank to not score the line at all.
DEPAS_LINE_PREFERENCE=1 > 3,6 > 2,4,4A,5
# Ideal floor. At or above it a listing gets full marks; lower ones score worse
# without being excluded, and the top floor is docked for the roof it sits under.
# Never a cutoff: the portals with the most listings publish no floor at all.
DEPAS_TARGET_FLOOR=5
# Hard floor on size, but an undeclared area still alerts — it just scores at the
# bottom of the component. At or over TARGET_AREA a listing gets full marks.
DEPAS_ALERT_MIN_AREA=42
DEPAS_TARGET_AREA=50
# Wanted security type. Not a cutoff: listings without it score lower on their own
# component, which matters because many publishers simply never declare the field.
DEPAS_ALERT_SECURITY=24 horas
DEPAS_ALERT_MIN_GRADE=

# What you pay today, net. Set it and every card shows the difference.
DEPAS_CURRENT_COST=

# Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
