# Seeds the settings, once. The first `connect()` on a fresh database copies every
# value below into the `preferences` table, and after that the table is the
# configuration: editing this file changes nothing until `depas config import-env
# --force` asks for it. Edit a setting with `depas config set NOMBRE valor`, and
# `depas config` lists everything with what it means.
#
# Two exceptions stay here for good, because they are read before a database can be
# opened or must not sit beside the data: TELEGRAM_BOT_TOKEN and DEPAS_DB_PATH.

# Monthly CLP you expect to collect by leasing out the unit's parking and storage.
# Both default to 0, which makes net cost equal total cost.
DEPAS_PARKING_INCOME=0
DEPAS_STORAGE_INCOME=0

# Relative weight of each grading component (even split by default).
# A grade is a percentile against everything currently scraped: 80 beats 80% of listings.
DEPAS_VALUE_WEIGHT=1
DEPAS_COST_WEIGHT=1
DEPAS_WALK_WEIGHT=1
DEPAS_AREA_WEIGHT=1
DEPAS_AMENITIES_WEIGHT=1
DEPAS_SECURITY_WEIGHT=1
DEPAS_FLOOR_WEIGHT=1
DEPAS_METRO_WEIGHT=1
DEPAS_COMMUTE_WEIGHT=1
DEPAS_AGE_WEIGHT=1

# Where the SQLite file lives. Pinned to /data/depas.db in docker-compose.yml.
# DEPAS_DB_PATH=depas.db

# Hourly watch: which communes to scrape, plus the coarse portal-side filters.
# Sample values only -- put your real search in .env, which is gitignored.
DEPAS_COMMUNES=nunoa,santiago
DEPAS_BEDROOMS_MIN=2

# Requirements applied to alerts after enrichment. Every figure here is the net
# monthly cost -- rent + gastos comunes - sublet income -- never the asking rent,
# which is not a number worth setting. Leave any blank to not filter on it.
# What we aim to spend. At or under this a listing gets full marks on cost, then
# the score degrades to zero at DEPAS_COST_MAX. Nothing is excluded for being over target.
DEPAS_COST_TARGET=850000
# Hard ceiling: over this, no alert. The rent ceiling used while crawling is derived
# from these figures, so there is no separate asking-rent setting.
DEPAS_COST_MAX=950000
# Ideal walk to the Metro. At or under it a listing gets full marks on walk, then
# the score degrades to zero at DEPAS_WALK_MAX. Nothing is excluded for being over.
DEPAS_WALK_TARGET=10
DEPAS_WALK_MAX=15
# Every place you need to be able to reach, as many as you like: `name,lat,lon` per
# entry, separated by `;`. Right-click the spot in Google Maps for the coordinates.
# The name is only a label, and it is what the alert card and the tables print.
DEPAS_LOCATIONS=first,-33.41720,-70.60600; second,-33.49830,-70.61140
# Travel time is whichever of walking, bus and Metro is fastest, routed by Transitous
# and measured to the location each listing reaches worst. At or under the target it
# gets full marks, the score degrades to zero at the ceiling, and over it: no alert.
DEPAS_COMMUTE_TARGET=25
DEPAS_COMMUTE_MAX=60

# Metro lines in tiers, best first: ">" separates tiers, "," lists lines worth the same.
# A station is scored by the best line calling at it, so an interchange takes its better
# one. A line left off ranks below every tier. Leave blank to not score the line at all.
DEPAS_METRO_TIERS=1 > 3,6 > 2,4,4A,5
# Ideal floor. At or above it a listing gets full marks; lower ones score worse
# without being excluded, and the top floor is docked for the roof it sits under.
# Never a cutoff: the portals with the most listings publish no floor at all.
DEPAS_FLOOR_TARGET=5
# Hard floor on size, but an undeclared area still alerts — it just scores at the
# bottom of the component. At or over TARGET_AREA a listing gets full marks.
DEPAS_AREA_MIN=42
DEPAS_AREA_TARGET=50
# Ideal antigüedad in years, and the one target that applies even when left blank:
# 25 is the standing rule, so unsetting this moves nothing. At or under it a listing
# gets full marks; older ones score worse without ever being excluded, and one that
# published no antigüedad is left unscored rather than assumed old. Portals publish
# this either as a number of years or as the year the building went up, and both are
# read as an age. Zero DEPAS_AGE_WEIGHT to stop scoring it at all.
DEPAS_AGE_TARGET=25
# Latest move-in date you would accept, as YYYY-MM-DD. Listings that only free up
# after it are not alerted on. Portals word availability every way there is
# ("Inmediata", "15 julio", "01/09/2026", a month on its own) and most never state
# it at all -- an undeclared date never costs a listing its alert.
DEPAS_AVAILABLE_BY=2026-11-01
# Wanted security type. Not a cutoff: listings without it score lower on their own
# component, which matters because many publishers simply never declare the field.
DEPAS_SECURITY_WANTED=24 horas
DEPAS_GRADE_MIN=
# Not settable, and deliberately: an amoblado apartment is never alerted on, whatever
# it costs, and it is kept out of the pool the others are graded against too.

# What you pay today, net. Set it and every card shows the difference. Leave it blank
# if DEPAS_CURRENT_HOME is set: the net cost is worked out from there instead.
DEPAS_CURRENT_COST=

# Your own apartment, as one JSON object on one line, so `/compare` in a card's thread
# can set any listing against it figure by figure -- cost, size, floor, antigüedad,
# UF/m2, Metro, travel time to every DEPAS_LOCATIONS place, and amenities gained or
# lost. Required: price_clp, common_expenses, area_m2, lat, lon. Everything else is
# optional and simply leaves its line out. The keys are the listing column names, so
# any amenity from the cards works: has_elevator, has_concierge, has_pool, has_gym,
# has_heating, has_air_conditioning, gated_community, pets_allowed, has_terrace.
# parking_spaces and storage_units are netted off with the same sublet income as a
# listing, and age_years accepts either the age or the year the building went up.
DEPAS_CURRENT_HOME={"commune":"nunoa","price_clp":800000,"common_expenses":130000,"area_m2":62,"bedrooms":2,"bathrooms":1,"floor":3,"building_floors":8,"age_years":30,"parking_spaces":1,"storage_units":0,"lat":-33.45590,"lon":-70.59780,"has_elevator":true,"has_concierge":true,"has_terrace":true}

# Telegram. TELEGRAM_CHAT_ID takes either kind of chat and switching is just this
# value -- `depas chats` lists what the bot can see, and every watch pass prints
# which kind it posted to. Prefer a CHANNEL with a linked discussion group: each
# card lands as a channel post with its own Comments thread, so a listing can be
# discussed on its own instead of every conversation piling into one group. Posting
# straight to the group works too, it just gives the cards nowhere to be discussed.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
