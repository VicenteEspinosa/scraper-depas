# Machine-specific values, and the only two that are not settings: they are read
# before a database can be opened, or must not sit in the table beside the data.
# Copy to .env, which is gitignored.
#
# Everything else you can tune lives in the `preferences` table, seeded from
# seed.env the first time a database is opened. `depas config` lists it all;
# `depas config set NAME valor` edits one.

# From @BotFather. A credential, so it never goes in seed.env.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF

# Where the SQLite file lives. Pinned to /data/depas.db in docker-compose.yml.
# DEPAS_DB_PATH=depas.db

# Any setting from seed.env can also be overridden here, per machine -- the
# environment wins over the file, but only on the first seed.
# DEPAS_COST_MAX=950000
